# KoBox-managed file for alice — DO NOT EDIT.
# This file is rendered declaratively and re-applied idempotently; manual
# edits are overwritten. Per-user behavior (public trackers, sync) lives in
# the KoBox database. Personal additions belong in
# /home/alice/rtorrent/config.d/99-*.rc — KoBox never touches those.

## Layout
method.insert = cfg.homedir, private|const|string, (cat, "/home/alice/")
method.insert = cfg.basedir, private|const|string, (cat, (cfg.homedir), "rtorrent/")
method.insert = cfg.logdir, private|const|string, (cat, (cfg.homedir), "logs/")
method.insert = cfg.config, private|const|string, (cat, (cfg.basedir), "config.d/")
method.insert = cfg.complete, private|const|string, (cat, (cfg.basedir), "complete/")
method.insert = cfg.session, private|const|string, (cat, "/home/alice/rtorrent/.session/")
method.insert = cfg.watch, private|const|string, (cat, (cfg.basedir), "watch/")
method.insert = cfg.torrents, private|const|string, (cat, (cfg.basedir), "torrents/")
method.insert = system.startup_time, value|const, (system.time)
method.insert = d.data_path, simple,\
    "if=(d.is_multi_file),\
        (cat, (d.directory), /),\
        (cat, (d.directory), /, (d.name))"

## Bootstrap the layout FIRST: later sections (logs, session) expect the
## directories to exist at parse time — rtorrent executes this file top-down.
execute.throw = sh, -c, (cat, "mkdir -p ", (cfg.logdir))
execute.throw = sh, -c, (cat, "mkdir -p ", (cfg.config))
execute.throw = sh, -c, (cat, "mkdir -p ", (cfg.complete))
execute.throw = sh, -c, (cat, "mkdir -p ", (cfg.session))
execute.throw = sh, -c, (cat, "mkdir -p ", (cfg.watch))
execute.throw = sh, -c, (cat, "mkdir -p ", (cfg.torrents))

## Event hooks -> KoBox shims (typed job pipeline; zero logic in the shims)
method.set_key = event.download.inserted_new, kobox_inserted_new, "execute2={sh,/home/alice/.rTorrent_inserted_new.sh,$d.hash=,$d.name=,$d.directory=,$d.loaded_file=,$d.custom2=,$d.custom1=,$d.is_private=}"
method.set_key = event.download.finished, kobox_finished, "execute2={sh,/home/alice/.rTorrent_finished.sh,$d.hash=,$d.base_path=,$d.directory=,$d.name=,$d.loaded_file=,$d.custom1=}"
method.set_key = event.download.erased, kobox_erased, "execute2={sh,/home/alice/.rTorrent_erased.sh,$d.hash=,$d.name=,$d.directory=}"

## Network
network.port_range.set = 45001-45001
network.port_random.set = 0
network.http.capath.set = /etc/ssl/certs
network.http.ssl_verify_peer.set = 1
network.http.ssl_verify_host.set = 1
network.http.dns_cache_timeout.set = 25
network.xmlrpc.size_limit.set = 16M
network.scgi.open_port = 127.0.0.1:51101

## System
system.daemon.set = true
system.file.allocate.set = 1
system.file.max_size.set = -1
system.file.split_size.set = -1
system.cwd.set = (directory.default)

## Memory / pieces
pieces.hash.on_completion.set = 0
pieces.memory.max.set = 512M

## Directories & session
directory.default.set = (cat, (cfg.complete))
session.path.set = (cat, (cfg.session))
session.on_completion.set = 1
session.use_lock.set = 0

## Trackers
trackers.enable = 1
trackers.numwant.set = -1
trackers.use_udp.set = 0

## Protocol
protocol.encryption.set = require,require_RC4,allow_incoming,try_outgoing,enable_retry,prefer_plaintext
protocol.pex.set = 0
dht.mode.set = disable

## Misc
encoding.add = utf8

## Scheduling
schedule2 = low_diskspace,5,60,close_low_diskspace=500M
schedule2 = session_save,240,300,((session.save))

## Throttle
throttle.global_up.max_rate.set_kb = 0
throttle.global_down.max_rate.set_kb = 0
throttle.max_uploads.global.set = 0
throttle.max_downloads.global.set = 0
throttle.min_peers.normal.set = 1
throttle.max_peers.normal.set = 100
throttle.min_peers.seed.set = -1
throttle.max_peers.seed.set = -1
throttle.max_downloads.set = 50
throttle.max_uploads.set = 50
throttle.max_uploads.div.set = 0
throttle.max_downloads.div.set = 0

## Logs
log.execute = (cat, (cfg.logdir), "execute.log")
log.open_file = "rtorrent", (cat, (cfg.logdir), "rtorrent.log")
log.add_output = "notice", "rtorrent"

## PID file and config.d drop-ins
execute.nothrow = sh, -c, (cat, "echo >", (session.path), "rtorrent.pid", " ", (system.pid))
execute.nothrow = sh, -c, (cat,\
    "find ", (cfg.config), " -name '*.rc' ",\
    "| sort | sed -re 's/^/import=/' > ", (cfg.config), ".import")
try_import = (cat, (cfg.config), ".import")
