# KoBox-managed OpenVPN server (tun) — DO NOT EDIT (rendered declaratively).
port 8194
proto udp4
dev tun
topology subnet
server 10.0.1.0 255.255.255.0
ca /etc/openvpn/kobox-pki/ca.crt
cert /etc/openvpn/kobox-pki/issued/server.crt
key /etc/openvpn/kobox-pki/private/server.key
crl-verify /etc/openvpn/kobox-pki/crl.pem
dh none
data-ciphers AES-256-GCM:AES-128-GCM
auth SHA256
keepalive 10 120
persist-key
persist-tun
user nobody
group nogroup
status /var/log/openvpn/kobox-tun-status.log
verb 3
push "dhcp-option DNS 10.0.1.1"
