# KoBox-managed — DO NOT EDIT (rendered declaratively).
[Unit]
Description=KoBox root worker (typed job queue consumer)
After=network.target
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/usr/bin/node /opt/kobox/current/dist/interfaces/worker/main.js
EnvironmentFile=-/etc/kobox/worker.env
UMask=0007
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
