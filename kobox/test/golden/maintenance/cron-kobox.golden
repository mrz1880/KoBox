# kobox scheduler - managed by KoBox, do not edit
# Each entry runs the kobox CLI, which mostly enqueues a typed job for the
# kobox-worker service; its output goes to the journal (tag kobox-cron).
SHELL=/bin/sh
PATH=/usr/sbin:/usr/bin:/sbin:/bin

*/5 * * * * root systemd-cat -t kobox-cron --stderr-priority=warning /usr/local/bin/kobox resolve-dyndns
*/5 * * * * root systemd-cat -t kobox-cron --stderr-priority=warning /usr/local/bin/kobox send-mails
*/5 * * * * root systemd-cat -t kobox-cron --stderr-priority=warning /usr/local/bin/kobox evaluate-fair-use
0 */6 * * * root systemd-cat -t kobox-cron --stderr-priority=warning /usr/local/bin/kobox update-blocklists
10 0 * * * root systemd-cat -t kobox-cron --stderr-priority=warning /usr/local/bin/kobox renew-tracker-certs
30 5 * * * root systemd-cat -t kobox-cron --stderr-priority=warning /usr/local/bin/kobox run-backup
*/15 * * * * root systemd-cat -t kobox-cron --stderr-priority=warning /usr/local/bin/kobox index-media
20 * * * * root systemd-cat -t kobox-cron --stderr-priority=warning /usr/local/bin/kobox sample-disk-usage
40 5 * * * root systemd-cat -t kobox-cron --stderr-priority=warning /usr/local/bin/kobox check-package-updates
5 * * * * root systemd-cat -t kobox-cron --stderr-priority=warning /usr/local/bin/kobox send-pending-transfers
*/10 * * * * root systemd-cat -t kobox-cron --stderr-priority=warning /usr/local/bin/kobox restart-stalled-hash-checks
