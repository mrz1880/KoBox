# kobox scheduler - managed by KoBox, do not edit
# Every entry enqueues a typed job; the kobox-worker service executes.
SHELL=/bin/sh
PATH=/usr/sbin:/usr/bin:/sbin:/bin

*/5 * * * * root /usr/local/bin/kobox resolve-dyndns
*/5 * * * * root /usr/local/bin/kobox send-mails
*/5 * * * * root /usr/local/bin/kobox evaluate-fair-use
0 */6 * * * root /usr/local/bin/kobox update-blocklists
10 0 * * * root /usr/local/bin/kobox renew-tracker-certs
30 5 * * * root /usr/local/bin/kobox run-backup
*/2 * * * * root /usr/local/bin/kobox poll-debrid-downloads
*/15 * * * * root /usr/local/bin/kobox index-media
40 5 * * * root /usr/local/bin/kobox check-package-updates
5 * * * * root /usr/local/bin/kobox send-pending-transfers
