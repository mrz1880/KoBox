// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`job contract > should_keep_the_wire_contract_stable 1`] = `
{
  "change-password": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "passwordHash": {
        "minLength": 16,
        "pattern": "^\\$(6|y)\\$[A-Za-z0-9./=,$-]+$",
        "type": "string",
      },
      "username": {
        "pattern": "^[a-z][a-z0-9]{0,31}$",
        "type": "string",
      },
    },
