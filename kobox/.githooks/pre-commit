#!/usr/bin/env bash
# Fast gate — cheap checks that run on every commit. Keeps broken code out of
# history and off CI (GitHub Free minutes are the constraint).
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root/kobox"

# Only run the toolchain if kobox/ has staged changes — docs-only commits skip it.
if git diff --cached --name-only | grep -q '^kobox/'; then
  echo "[pre-commit] lint + typecheck"
  pnpm lint
  pnpm typecheck
else
  echo "[pre-commit] no kobox/ changes staged — skipping toolchain checks"
fi

# The identifier guard runs on EVERY staged path (public repo): a stray doc or
# handoff note leaks just as hard as source code.
echo "[pre-commit] guard: no production/personal identifiers"
# The detection list is base64-encoded so the very identifiers we forbid do
# not appear in cleartext in this public repo. Decode at runtime only.
forbidden="$(printf '%s' \
  'a29mYW1pbHl8MTk1XC4xNTRcLjE3MXxtcnoxODgwfFxiYW50aG9ueVxifFxibHVkb1xifFxibHVkb2ZcYnxcYmxlb25ldWZcYnxcYmp1bGllblxifFxidGl0aVxifFxidG9ueXpcYnxcYmZyZWRcYnxcYnJvbWFpblxi' \
  | base64 -d)"
# One deliberate exception, encoded for the same reason as the list above: the
# public NanoMon repository whose release KoBox pins. Authorised by the owner on
# 2026-08-16 so the pin in OPS.md is copy-pasteable rather than a placeholder.
# The substring is REMOVED from the line rather than the line being skipped, so
# any other identifier sharing that line still blocks.
allowed="$(printf '%s' \
  'aHR0cHM6Ly9naXRodWIuY29tL21yejE4ODAvbmFub21vbg==' \
  | base64 -d)"
if git -C "$repo_root" diff --cached -U0 --no-color \
    | grep -nE '^\+' \
    | grep -viE '^\+\+\+' \
    | sed "s|$allowed||g" \
    | grep -inE "$forbidden"; then
  echo "[pre-commit] BLOCKED: staged lines contain a production/personal identifier." >&2
  exit 1
fi
