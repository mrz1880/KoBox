#!/usr/bin/env bash
# Fast gate — cheap checks that run on every commit. Keeps broken code out of
# history and off CI (GitHub Free minutes are the constraint).
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root/kobox"

# Only run the toolchain if kobox/ has staged changes — docs-only commits skip it.
if git diff --cached --name-only | grep -q '^kobox/'; then
  echo "[pre-commit] lint + typecheck"
  pnpm lint
  pnpm typecheck
else
  echo "[pre-commit] no kobox/ changes staged — skipping toolchain checks"
fi

# The identifier guard runs on EVERY staged path (public repo): a stray doc or
# handoff note leaks just as hard as source code. The list itself is never in
# the repo, not even encoded: each clone keeps its own, untracked, in
#   .git/info/forbidden-identifiers           (this repository)
#   ~/.config/git/forbidden-identifiers        (every repository of this user)
# one extended regex per line, '#' for comments. Deliberate exceptions go, one
# substring per line, in the matching allowed-identifiers file: the substring
# is removed from the line rather than the line being skipped, so any other
# identifier on that line still blocks.
read_list() {
  for file in "$@"; do
    [ -r "$file" ] && grep -vE '^[[:space:]]*(#|$)' "$file"
  done
  return 0
}
git_info="$(git -C "$repo_root" rev-parse --path-format=absolute --git-common-dir)/info"
user_lists="${XDG_CONFIG_HOME:-$HOME/.config}/git"
forbidden="$(read_list "$git_info/forbidden-identifiers" "$user_lists/forbidden-identifiers" | paste -sd'|' -)"
if [ -z "$forbidden" ]; then
  echo "[pre-commit] guard: no identifier list in .git/info or ~/.config/git, nothing checked"
  exit 0
fi
echo "[pre-commit] guard: no production/personal identifiers"
staged="$(git -C "$repo_root" diff --cached -U0 --no-color | grep -E '^\+' | grep -vE '^\+\+\+' || true)"
while IFS= read -r allowed; do
  staged="${staged//"$allowed"/}"
done < <(read_list "$git_info/allowed-identifiers" "$user_lists/allowed-identifiers")
if printf '%s\n' "$staged" | grep -inE "$forbidden"; then
  echo "[pre-commit] BLOCKED: staged lines contain a production/personal identifier." >&2
  exit 1
fi
