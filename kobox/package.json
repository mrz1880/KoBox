{
  "name": "kobox",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@10.31.0",
  "description": "KoBox: multi-user seedbox for a Debian 13 dedicated server",
  "type": "module",
  "bin": {
    "kobox": "dist/interfaces/cli/main.js",
    "kobox-worker": "dist/interfaces/worker/main.js",
    "kobox-portal": "dist/interfaces/http/main.js"
  },
  "engines": {
    "node": ">=24"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ],
    "overrides": {
      "qs@<6.15.2": ">=6.15.2",
      "esbuild@<0.25.0": ">=0.25.0",
      "vite@<8.1.6": ">=8.1.6"
    }
  },
  "scripts": {
    "prepare": "git config --local core.hooksPath kobox/.githooks || true",
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit",
    "test": "vitest run test/unit test/component test/contract",
    "test:unit": "vitest run test/unit",
    "test:component": "vitest run test/component",
    "test:contract": "vitest run test/contract",
    "test:int": "vitest run test/integration",
    "test:e2e": "vitest run --no-file-parallelism test/e2e",
    "coverage": "vitest run test/unit test/component test/contract --coverage",
    "build": "tsc -p tsconfig.build.json",
    "mutation": "stryker run"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/formbody": "^8.0.2",
    "better-sqlite3": "^12.11.1",
    "commander": "^14.0.3",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/typescript-checker": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^4.1.12",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "fast-check": "^4.10.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^4.1.12"
  }
}
