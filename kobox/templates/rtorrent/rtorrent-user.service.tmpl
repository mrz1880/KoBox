# KoBox-managed unit — DO NOT EDIT: rendered declaratively, re-applied idempotently.
[Unit]
Description=KoBox rTorrent instance for {{username}}
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# No Group= override: the user's own primary group must stay first so rtorrent
# can read the root:<user> 0640 managed files; kobox-users comes in as a
# supplementary group via the user database (initgroups).
User={{username}}
WorkingDirectory={{home}}
Environment=HOME={{home}}
ExecStart=/usr/bin/rtorrent -n -o import={{home}}/.rtorrent.rc
Restart=on-failure
RestartSec=5
UMask=0027

[Install]
WantedBy=multi-user.target
