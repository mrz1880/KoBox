# KoBox-managed unit — DO NOT EDIT: rendered declaratively, re-applied idempotently.
[Unit]
Description=KoBox rTorrent instance for {{username}}
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{username}}
Group=kobox-users
WorkingDirectory={{home}}
Environment=HOME={{home}}
ExecStart=/usr/bin/rtorrent -n -o import={{home}}/.rtorrent.rc
Restart=on-failure
RestartSec=5
UMask=0027

[Install]
WantedBy=multi-user.target
